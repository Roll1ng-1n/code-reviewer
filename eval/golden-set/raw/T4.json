      "following_url": "https://api.github.com/users/pelovett/following{/other_user}",
      "gists_url": "https://api.github.com/users/pelovett/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/pelovett/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/pelovett/subscriptions",
      "organizations_url": "https://api.github.com/users/pelovett/orgs",
      "repos_url": "https://api.github.com/users/pelovett/repos",
      "events_url": "https://api.github.com/users/pelovett/events{/privacy}",
