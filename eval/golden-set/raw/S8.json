    "title": "Use the field name in validation JSON schemas when `validate_by_alias` is `False`",
    "user": {
      "login": "MLuc24",
      "id": 165113247,
      "node_id": "U_kgDOCddtnw",
      "avatar_url": "https://avatars.githubusercontent.com/u/165113247?v=4",
