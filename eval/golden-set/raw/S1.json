        "repos_url": "https://api.github.com/users/open-swe%5Bbot%5D/repos",
        "events_url": "https://api.github.com/users/open-swe%5Bbot%5D/events{/privacy}",
        "received_events_url": "https://api.github.com/users/open-swe%5Bbot%5D/received_events",
        "type": "Bot",
